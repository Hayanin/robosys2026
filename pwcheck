import sys
import re


def check_strength(pw):
    score = 0
    if len(pw) >= 8:
        score += 1
    if len(pw) >= 12:
        score += 1
    if re.search(r"[a-z]", pw) and re.search(r"[A-Z]", pw):
        score += 1
    if re.search(r"[0-9]", pw):
        score += 1
    if re.search(r"[^a-zA-Z0-9]", pw):
        score += 1

    if score >= 4:
        return "STRONG"
    elif score >= 2:
        return "MEDIUM"
    else:
        return "WEAK"


def main():
    has_input = False
    for line in sys.stdin:
        pw = line.rstrip("\r\n")
        if not pw:
            continue
        has_input = True
        level = check_strength(pw)
        print(f"{level}: {pw}")

    if not has_input:
        print("Error: empty input", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
